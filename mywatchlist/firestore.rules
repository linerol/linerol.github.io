rules_version = '2';
// Règles de sécurité Firestore de /mywatchlist.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Connecté avec un email vérifié
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(me()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    function isEditor() { return isMember() && role() in ['admin', 'editor']; }
    // Un document rangé sous l'identifiant du compte, ou sous l'email (anciens documents)
    function isMine(key) { return key == request.auth.uid || key == me(); }

    // Membres : toi seul gères la liste, chacun voit sa propre fiche
    match /members/{email} {
      allow read: if isAdmin() || (signedIn() && email == me());
      allow write: if isAdmin();
      // Chaque membre relie son compte et choisit son pseudo, rien d'autre
      allow update: if signedIn() && email == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'pseudo', 'pseudoKey'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Annuaire des pseudos : ce que les membres voient les uns des autres (jamais l'email).
    // Un pseudo = un document : deux membres ne peuvent pas avoir le même.
    match /pseudos/{key} {
      allow read: if isMember();
      allow create: if isMember() && key.matches('^[a-z0-9_-]{2,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20;
      allow update: if isMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid && request.resource.data.key == key
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20;
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    // Corbeille : titres supprimés, gardés 30 jours, visibles par toi seul
    match /trash/{id} {
      allow read, write: if isAdmin();
    }

    // Réglages partagés (sites de la page « Où regarder ») : lus par les membres, modifiés par toi
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Ta liste : lue par les membres, modifiée par toi seul
    match /titles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();

      // « Je l'ai vu aussi » : un document par membre, que lui seul modifie
      match /seen/{who} {
        allow read: if isMember();
        allow write: if isMember() && isMine(who);
      }
    }

    // Titres suivis (« Me prévenir ») : privés à chaque membre
    match /follows/{who} {
      allow read, write: if isMember() && isMine(who);
    }

    // Journal des membres et des accès : réservé à l'admin
    match /adminLog/{id} {
      allow read, create: if isAdmin();
    }

    // Suggestions (lecteurs) et modifications proposées (éditeurs), à valider
    match /requests/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && (request.resource.data.type == 'suggestion'
            || (request.resource.data.type == 'edit' && isEditor()));
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isMember() && isMine(resource.data.by) && resource.data.status == 'pending');

      // Votes : un document par votant
      match /votes/{voter} {
        allow read: if isMember();
        allow create: if isMember() && voter == request.auth.uid;
        allow delete: if isMember() && isMine(voter);
      }
    }

    // Historique : écrit par l'espace admin
    match /history/{id} {
      allow read: if isMember();
      allow create: if isAdmin();
    }

    // Demandes d'accès : n'importe quel compte vérifié peut demander
    match /accessRequests/{email} {
      allow create: if signedIn() && email == me();
      allow read: if isAdmin() || (signedIn() && email == me());
      allow delete: if isAdmin();
    }
  }
}
